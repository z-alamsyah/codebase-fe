# Copy to .env.local for local development:  cp .env.example .env.local
# All variables are server-side only (no NEXT_PUBLIC_*), validated in src/lib/config/env.ts.

# ---------------------------------------------------------------- App / Auth.js
AUTH_URL=http://localhost:3000            # public URL of this app (https:// in production -> Secure cookies)
AUTH_SECRET=                              # encrypts the session cookie: openssl rand -base64 32

# ---------------------------------------------------------------- Zitadel (values from `make zitadel-bootstrap` in codebase-go)
ZITADEL_DOMAIN=http://localhost:8081
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
ZITADEL_PROJECT_ID=                       # the backend checks this as token audience

# ---------------------------------------------------------------- Backend (codebase-go)
BACKEND_URL=http://localhost:8080

# ---------------------------------------------------------------- Logging (server side)
LOG_LEVEL=info                            # debug | info | warn | error
LOG_FORMAT=pretty                         # pretty (local) | json (servers, log collectors)
LOG_REDACT_KEYS=password,token,access_token,refresh_token,id_token,secret,authorization,cookie,pin,otp,cvv,card_number

# Set to 1 only for builds without real secrets (CI, Docker build stage).
# SKIP_ENV_VALIDATION=1
